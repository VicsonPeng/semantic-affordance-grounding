@prefix g02:     <https://hcis.io/ontology/aicapstone/2026/group02/> .
@prefix cap:     <https://hcis.io/ontology/aicapstone/2026/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix vann:    <http://purl.org/vocab/vann/> .
@prefix foaf:    <http://xmlns.com/foaf/0.1/> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .

# ==============================================================
# Ontology Metadata  (Person A — repo + skeleton)
# ==============================================================

<https://hcis.io/ontology/aicapstone/2026/group02>
    a owl:Ontology ;
    owl:imports <https://hcis.io/ontology/aicapstone/2026> ;
    rdfs:label "AI Capstone 2026 Group 02 Ontology"@en ;
    rdfs:comment
        "Group 02 ontology for semantic affordance grounding. The primary task is cup stacking; the cutlery-arrangement and toy-block-collection baseline objects are also modeled. It imports the shared course vocabulary, supplies the GraspableObject inference rule, and declares the task object instances."@en ;
    dcterms:title "AI Capstone 2026 Group 02 Ontology"@en ;
    dcterms:description
        "This ontology extends the course affordance vocabulary with group-specific object instances, a gripper-capability extension, and the graspability inference rule for the Group 02 task environment."@en ;
    dcterms:creator g02:group02 ;
    dcterms:created "2026-05-31"^^xsd:date ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    vann:preferredNamespacePrefix "g02" ;
    vann:preferredNamespaceUri "https://hcis.io/ontology/aicapstone/2026/group02/" .

g02:group02
    a foaf:Group ;
    foaf:name "AI Capstone 2026 Group 02"@en ;
    foaf:member g02:m112550128 , g02:m112550148 , g02:m112550166 ,
                g02:m112550027 , g02:m112550117 , g02:m112550116 .

g02:m112550128 a foaf:Person ; rdfs:label "彭程 (112550128)"@zh ;   foaf:name "彭程"@zh ;   dcterms:identifier "112550128" .
g02:m112550148 a foaf:Person ; rdfs:label "周宇彥 (112550148)"@zh ; foaf:name "周宇彥"@zh ; dcterms:identifier "112550148" .
g02:m112550166 a foaf:Person ; rdfs:label "張紹安 (112550166)"@zh ; foaf:name "張紹安"@zh ; dcterms:identifier "112550166" .
g02:m112550027 a foaf:Person ; rdfs:label "余逸翔 (112550027)"@zh ; foaf:name "余逸翔"@zh ; dcterms:identifier "112550027" .
g02:m112550117 a foaf:Person ; rdfs:label "張盛瑋 (112550117)"@zh ; foaf:name "張盛瑋"@zh ; dcterms:identifier "112550117" .
g02:m112550116 a foaf:Person ; rdfs:label "張祐廷 (112550116)"@zh ; foaf:name "張祐廷"@zh ; dcterms:identifier "112550116" .

# ==============================================================
# Person B — GraspableObject Inference Rule
#
# cap:GraspableObject is a reserved course term (spec §8) that the provided
# course-affordance.ttl ships without a defining axiom. We supply the OWL
# serialization of the reasoning pattern from spec Listing 5 so a reasoner can
# DERIVE graspability instead of it being asserted on individuals:
#
#   cap:GraspableObject  ≡  cap:PhysicalObject
#                           ⊓ ∃ cap:hasAffordance.cap:GraspingAffordance
# ==============================================================

cap:GraspableObject
    a owl:Class ;
    rdfs:label "graspable object"@en ;
    rdfs:comment
        "A physical object that the reasoner classifies as graspable because it is a cap:PhysicalObject and has at least one cap:GraspingAffordance. Membership is INFERRED, never asserted directly on individuals."@en ;
    skos:scopeNote
        "Local reasoning target for this homework; not equivalent to any external role such as soma:MovedObject (see ontology/imports/course-alignment.ttl)."@en ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            cap:PhysicalObject
            [ a owl:Restriction ;
              owl:onProperty cap:hasAffordance ;
              owl:someValuesFrom cap:GraspingAffordance ]
        )
    ] .

# ==============================================================
# Group-specific schema extensions (gripper capability)
# ==============================================================

g02:hasMaxGripWidth
    a owl:DatatypeProperty ;
    rdfs:domain cap:EndEffector ;
    rdfs:range xsd:decimal ;
    rdfs:label "has maximum grip width"@en ;
    rdfs:comment
        "Maximum object width (metres) an end effector can open to and grip. Group 02 extension relating gripper capability to object width (cap:hasApproxWidth)."@en .

g02:hasContainerTarget
    a owl:ObjectProperty ;
    rdfs:domain cap:Task ;
    rdfs:range cap:PhysicalObject ;
    rdfs:label "has container target"@en ;
    rdfs:comment
        "Relates a task to the object that receives/collects other objects (e.g. the basket). Being a container target does NOT make an object graspable. Group 02 extension."@en .

g02:robot01
    a cap:RobotAgent ;
    rdfs:label "Group 02 robot agent"@en ;
    rdfs:comment "The gripper-equipped robot agent observing the Group 02 task environment."@en .

g02:gripper01
    a cap:EndEffector ;
    rdfs:label "parallel-jaw gripper 01"@en ;
    rdfs:comment "The parallel-jaw gripper mounted on g02:robot01."@en ;
    g02:hasMaxGripWidth "0.085"^^xsd:decimal .

# ==============================================================
# Person C — Cup Stacking Instances (Primary Task)
# Cups are TargetObjects with grasping + stackability affordances => graspable.
# ==============================================================

g02:blueCupGraspingAffordance
    a cap:GraspingAffordance ;
    rdfs:label "blue cup grasping affordance"@en ;
    rdfs:comment "Grasping affordance of the blue cup; this is what triggers the GraspableObject inference."@en .

g02:blueCupStackingAffordance
    a cap:StackabilityAffordance ;
    rdfs:label "blue cup stackability affordance"@en ;
    rdfs:comment "Stackability affordance of the blue cup in the cup-stacking task."@en .

g02:blueCup01
    a cap:Cup ;
    rdfs:label "blue cup 01"@en ;
    rdfs:comment "The blue cup instance in Group 02's cup-stacking task environment."@en ;
    cap:hasColor "blue" ;
    cap:hasObjectLabel "blue_cup" ;
    cap:hasTaskRole cap:TargetObject ;
    cap:hasPoseFrame "world/object_blue_cup" ;
    cap:hasApproxWidth "0.070"^^xsd:decimal ;
    cap:hasAffordance g02:blueCupGraspingAffordance , g02:blueCupStackingAffordance ;
    cap:canBeManipulatedBy g02:gripper01 .

g02:pinkCupGraspingAffordance
    a cap:GraspingAffordance ;
    rdfs:label "pink cup grasping affordance"@en ;
    rdfs:comment "Grasping affordance of the pink cup."@en .

g02:pinkCupStackingAffordance
    a cap:StackabilityAffordance ;
    rdfs:label "pink cup stackability affordance"@en ;
    rdfs:comment "Stackability affordance of the pink cup in the cup-stacking task."@en .

g02:pinkCup01
    a cap:Cup ;
    rdfs:label "pink cup 01"@en ;
    rdfs:comment "The pink cup instance in Group 02's cup-stacking task environment."@en ;
    cap:hasColor "pink" ;
    cap:hasObjectLabel "pink_cup" ;
    cap:hasTaskRole cap:TargetObject ;
    cap:hasPoseFrame "world/object_pink_cup" ;
    cap:hasApproxWidth "0.070"^^xsd:decimal ;
    cap:hasAffordance g02:pinkCupGraspingAffordance , g02:pinkCupStackingAffordance ;
    cap:canBeManipulatedBy g02:gripper01 .

# ==============================================================
# Person D — Baseline Object Instances (spec §10)
# Knife/fork/toy blocks are grasp targets => graspable.
# Plate (support only) and basket (containment only) are task-relevant but
# NOT graspable — demonstrating task relevance != graspability (spec §6).
# ==============================================================

# --- Cutlery arrangement: knife, fork (grasp targets), plate (reference) ---
g02:knifeGraspingAffordance
    a cap:GraspingAffordance ;
    rdfs:label "knife grasping affordance"@en ;
    rdfs:comment "Grasping affordance of the knife."@en .

g02:knife01
    a cap:Knife ;
    rdfs:label "knife 01"@en ;
    rdfs:comment "Baseline knife instance for the cutlery-arrangement task."@en ;
    cap:hasColor "silver" ;
    cap:hasObjectLabel "knife" ;
    cap:hasTaskRole cap:TargetObject ;
    cap:hasPoseFrame "world/object_knife" ;
    cap:hasApproxWidth "0.020"^^xsd:decimal ;
    cap:hasAffordance g02:knifeGraspingAffordance ;
    cap:canBeManipulatedBy g02:gripper01 .

g02:forkGraspingAffordance
    a cap:GraspingAffordance ;
    rdfs:label "fork grasping affordance"@en ;
    rdfs:comment "Grasping affordance of the fork."@en .

g02:fork01
    a cap:Fork ;
    rdfs:label "fork 01"@en ;
    rdfs:comment "Baseline fork instance for the cutlery-arrangement task."@en ;
    cap:hasColor "silver" ;
    cap:hasObjectLabel "fork" ;
    cap:hasTaskRole cap:TargetObject ;
    cap:hasPoseFrame "world/object_fork" ;
    cap:hasApproxWidth "0.025"^^xsd:decimal ;
    cap:hasAffordance g02:forkGraspingAffordance ;
    cap:canBeManipulatedBy g02:gripper01 .

g02:plateSupportAffordance
    a cap:SupportAffordance ;
    rdfs:label "plate support affordance"@en ;
    rdfs:comment "Support affordance of the plate. The plate has NO grasping affordance, so it is not inferred as graspable."@en .

g02:plate01
    a cap:Plate ;
    rdfs:label "plate 01"@en ;
    rdfs:comment "Baseline plate instance, used as the placement reference in the cutlery-arrangement task — not a grasp target."@en ;
    cap:hasColor "white" ;
    cap:hasObjectLabel "plate" ;
    cap:hasTaskRole cap:ReferenceObject ;
    cap:hasPoseFrame "world/object_plate" ;
    cap:hasApproxWidth "0.220"^^xsd:decimal ;
    cap:hasAffordance g02:plateSupportAffordance .

# --- Toy block collection: toy blocks (grasp targets), basket (container) ---
g02:toyBlock01GraspingAffordance
    a cap:GraspingAffordance ;
    rdfs:label "toy block 01 grasping affordance"@en ;
    rdfs:comment "Grasping affordance of toy block 01."@en .

g02:toyBlock01
    a cap:ToyBlock ;
    rdfs:label "toy block 01"@en ;
    rdfs:comment "A red toy block to be collected into the basket."@en ;
    cap:hasColor "red" ;
    cap:hasObjectLabel "toy_block" ;
    cap:hasTaskRole cap:CollectableObject ;
    cap:hasPoseFrame "world/object_block_01" ;
    cap:hasApproxWidth "0.040"^^xsd:decimal ;
    cap:hasAffordance g02:toyBlock01GraspingAffordance ;
    cap:canBeManipulatedBy g02:gripper01 .

g02:toyBlock02GraspingAffordance
    a cap:GraspingAffordance ;
    rdfs:label "toy block 02 grasping affordance"@en ;
    rdfs:comment "Grasping affordance of toy block 02."@en .

g02:toyBlock02
    a cap:ToyBlock ;
    rdfs:label "toy block 02"@en ;
    rdfs:comment "A yellow toy block to be collected into the basket."@en ;
    cap:hasColor "yellow" ;
    cap:hasObjectLabel "toy_block" ;
    cap:hasTaskRole cap:CollectableObject ;
    cap:hasPoseFrame "world/object_block_02" ;
    cap:hasApproxWidth "0.040"^^xsd:decimal ;
    cap:hasAffordance g02:toyBlock02GraspingAffordance ;
    cap:canBeManipulatedBy g02:gripper01 .

g02:basketContainmentAffordance
    a cap:ContainmentAffordance ;
    rdfs:label "basket containment affordance"@en ;
    rdfs:comment "Containment affordance of the basket. The basket has NO grasping affordance, so it is not inferred as graspable."@en .

g02:basket01
    a cap:Basket ;
    rdfs:label "basket 01"@en ;
    rdfs:comment "Baseline basket instance, the container target in the toy-block-collection task — not a grasp target."@en ;
    cap:hasColor "brown" ;
    cap:hasObjectLabel "basket" ;
    cap:hasTaskRole cap:ContainerTarget ;
    cap:hasPoseFrame "world/object_basket" ;
    cap:hasApproxWidth "0.300"^^xsd:decimal ;
    cap:hasAffordance g02:basketContainmentAffordance .

# ==============================================================
# Task individuals
# ==============================================================

g02:cupStackingTask
    a cap:ManipulationTask ;
    rdfs:label "cup stacking task"@en ;
    rdfs:comment "Primary task: stack the blue and pink cups; both cups are manipulation targets."@en ;
    cap:hasTargetObject g02:blueCup01 , g02:pinkCup01 .

g02:cutleryArrangementTask
    a cap:ManipulationTask ;
    rdfs:label "cutlery arrangement task"@en ;
    rdfs:comment "Arrange the knife and fork relative to the plate; the plate is the placement reference."@en ;
    cap:hasTargetObject g02:knife01 , g02:fork01 ;
    cap:hasReferenceObject g02:plate01 .

g02:toyBlockCollectionTask
    a cap:ManipulationTask ;
    rdfs:label "toy block collection task"@en ;
    rdfs:comment "Collect the toy blocks into the basket; the basket is the container target."@en ;
    cap:hasTargetObject g02:toyBlock01 , g02:toyBlock02 ;
    g02:hasContainerTarget g02:basket01 .
