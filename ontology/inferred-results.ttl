owl:Thing a rdfs:Class,
        owl:Class ;
    owl:equivalentClass rdfs:Resource,
        owl:Thing .

cap:Affordance a rdfs:Class,
        owl:Class ;
    rdfs:label "affordance"@en ;
    rdfs:comment "An action possibility associated with an object in relation to a robot capability and task context."@en ;
    owl:equivalentClass cap:Affordance .

cap:Basket a rdfs:Class,
        owl:Class ;
    rdfs:label "basket"@en ;
    rdfs:comment "A container target used to receive toy blocks in the toy-block-collection task."@en ;
    rdfs:subClassOf _:nacdea7238cc94273af924a4b1fa6333fb7,
        cap:PhysicalObject ;
    owl:equivalentClass cap:Basket .

cap:CollectableObject a rdfs:Class,
        owl:Class,
        cap:TaskRole ;
    rdfs:label "collectable object"@en ;
    rdfs:comment "A task role for an object that should be collected into another object or location."@en ;
    rdfs:subClassOf cap:TaskRole ;
    owl:equivalentClass cap:CollectableObject .

cap:ContainerTarget a rdfs:Class,
        owl:Class,
        cap:TaskRole ;
    rdfs:label "container target"@en ;
    rdfs:comment "A task role for an object that receives or contains other objects."@en ;
    rdfs:subClassOf cap:TaskRole ;
    owl:equivalentClass cap:ContainerTarget .

cap:ContainmentAffordance a rdfs:Class,
        owl:Class ;
    rdfs:label "containment affordance"@en ;
    rdfs:comment "An affordance by which an object can contain or receive other objects."@en ;
    rdfs:subClassOf cap:Affordance ;
    owl:equivalentClass cap:ContainmentAffordance .

cap:Cup a rdfs:Class,
        owl:Class ;
    rdfs:label "cup"@en ;
    rdfs:comment "A container-like object used in the cup-stacking task."@en ;
    rdfs:subClassOf _:n24e15451f98e4fcfb85943c93941ed80b2,
        _:nacdea7238cc94273af924a4b1fa6333fb1,
        _:nacdea7238cc94273af924a4b1fa6333fb2,
        _:nacdea7238cc94273af924a4b1fa6333fb3,
        _:nacdea7238cc94273af924a4b1fa6333fb4,
        _:nacdea7238cc94273af924a4b1fa6333fb6,
        cap:PhysicalObject ;
    owl:equivalentClass cap:Cup .

cap:EndEffector a rdfs:Class,
        owl:Class ;
    rdfs:label "end effector"@en ;
    rdfs:comment "A robot component used to physically interact with objects, such as a gripper."@en ;
    owl:equivalentClass cap:EndEffector .

cap:Fork a rdfs:Class,
        owl:Class ;
    rdfs:label "fork"@en ;
    rdfs:comment "A cutlery object to be placed in the cutlery-arrangement task."@en ;
    rdfs:subClassOf _:n24e15451f98e4fcfb85943c93941ed80b2,
        _:nacdea7238cc94273af924a4b1fa6333fb1,
        _:nacdea7238cc94273af924a4b1fa6333fb3,
        _:nacdea7238cc94273af924a4b1fa6333fb4,
        _:nacdea7238cc94273af924a4b1fa6333fb6,
        cap:PhysicalObject ;
    owl:equivalentClass cap:Fork .

cap:GraspableObject a rdfs:Class,
        owl:Class ;
    rdfs:label "graspable object"@en ;
    rdfs:comment "A physical object that the reasoner classifies as graspable because it is a cap:PhysicalObject and has at least one cap:GraspingAffordance. Membership is INFERRED, never asserted directly on individuals."@en ;
    rdfs:subClassOf _:n24e15451f98e4fcfb85943c93941ed80b1,
        _:n24e15451f98e4fcfb85943c93941ed80b2,
        _:nacdea7238cc94273af924a4b1fa6333fb1,
        _:nacdea7238cc94273af924a4b1fa6333fb3,
        _:nacdea7238cc94273af924a4b1fa6333fb4,
        _:nacdea7238cc94273af924a4b1fa6333fb6,
        cap:PhysicalObject ;
    owl:equivalentClass _:n24e15451f98e4fcfb85943c93941ed80b1,
        cap:GraspableObject ;
    skos:scopeNote "Local reasoning target for this homework; not equivalent to any external role such as soma:MovedObject (see ontology/imports/course-alignment.ttl)."@en .

cap:GraspingAffordance a rdfs:Class,
        owl:Class ;
    rdfs:label "grasping affordance"@en ;
    rdfs:comment "An affordance by which an object may be grasped, held, lifted, or repositioned by a robot gripper."@en ;
    rdfs:subClassOf cap:Affordance ;
    owl:equivalentClass cap:GraspingAffordance .

cap:Knife a rdfs:Class,
        owl:Class ;
    rdfs:label "knife"@en ;
    rdfs:comment "A cutlery object to be placed in the cutlery-arrangement task."@en ;
    rdfs:subClassOf _:n24e15451f98e4fcfb85943c93941ed80b2,
        _:nacdea7238cc94273af924a4b1fa6333fb1,
        _:nacdea7238cc94273af924a4b1fa6333fb3,
        _:nacdea7238cc94273af924a4b1fa6333fb4,
        _:nacdea7238cc94273af924a4b1fa6333fb6,
        cap:PhysicalObject ;
    owl:equivalentClass cap:Knife .

cap:ManipulationTask a rdfs:Class,
        owl:Class ;
    rdfs:label "manipulation task"@en ;
    rdfs:comment "A task in which a robot changes the pose, state, or arrangement of physical objects."@en ;
    rdfs:subClassOf cap:Task ;
    owl:equivalentClass cap:ManipulationTask .

cap:PhysicalObject a rdfs:Class,
        owl:Class ;
    rdfs:label "physical object"@en ;
    rdfs:comment "A material object in the task environment that may be perceived, manipulated, used as a reference object, or assigned a task role."@en ;
    owl:equivalentClass cap:PhysicalObject .

cap:Plate a rdfs:Class,
        owl:Class ;
    rdfs:label "plate"@en ;
    rdfs:comment "A reference object used for arranging cutlery in the cutlery-arrangement task."@en ;
    rdfs:subClassOf _:nacdea7238cc94273af924a4b1fa6333fb5,
        cap:PhysicalObject ;
    owl:equivalentClass cap:Plate .

cap:ReferenceObject a rdfs:Class,
        owl:Class,
        cap:TaskRole ;
    rdfs:label "reference object"@en ;
    rdfs:comment "A task role for an object used as a spatial or semantic reference for arranging other objects."@en ;
    rdfs:subClassOf cap:TaskRole ;
    owl:equivalentClass cap:ReferenceObject .

cap:RobotAgent a rdfs:Class,
        owl:Class ;
    rdfs:label "robot agent"@en ;
    rdfs:comment "A robot or robot-controlled agent that can perceive objects, reason over the ontology, and act in the task environment."@en ;
    owl:equivalentClass cap:RobotAgent .

cap:StackabilityAffordance a rdfs:Class,
        owl:Class ;
    rdfs:label "stackability affordance"@en ;
    rdfs:comment "An affordance by which an object can participate in a stacking relation with another object."@en ;
    rdfs:subClassOf cap:Affordance ;
    owl:equivalentClass cap:StackabilityAffordance .

cap:SupportAffordance a rdfs:Class,
        owl:Class ;
    rdfs:label "support affordance"@en ;
    rdfs:comment "An affordance by which an object can support the placement or arrangement of other objects."@en ;
    rdfs:subClassOf cap:Affordance ;
    owl:equivalentClass cap:SupportAffordance .

cap:TargetObject a rdfs:Class,
        owl:Class,
        cap:TaskRole ;
    rdfs:label "target object"@en ;
    rdfs:comment "A task role for an object that is directly acted upon or manipulated."@en ;
    rdfs:subClassOf cap:TaskRole ;
    owl:equivalentClass cap:TargetObject .

cap:Task a rdfs:Class,
        owl:Class ;
    rdfs:label "task"@en ;
    rdfs:comment "A goal-directed activity to be performed or evaluated in the course project."@en ;
    owl:equivalentClass cap:Task .

cap:TaskRole a rdfs:Class,
        owl:Class ;
    rdfs:label "task role"@en ;
    rdfs:comment "A role that an object plays within a task."@en ;
    owl:equivalentClass cap:TaskRole .

cap:ToyBlock a rdfs:Class,
        owl:Class ;
    rdfs:label "toy block"@en ;
    rdfs:comment "A small object to be collected into the basket in the toy-block-collection task."@en ;
    rdfs:subClassOf _:n24e15451f98e4fcfb85943c93941ed80b2,
        _:nacdea7238cc94273af924a4b1fa6333fb1,
        _:nacdea7238cc94273af924a4b1fa6333fb3,
        _:nacdea7238cc94273af924a4b1fa6333fb4,
        _:nacdea7238cc94273af924a4b1fa6333fb6,
        cap:PhysicalObject ;
    owl:equivalentClass cap:ToyBlock .

