cap:group02 a owl:Ontology ;
    rdfs:label "AI Capstone 2026 Group 02 Ontology"@en ;
    dcterms:created "2026-05-31"^^xsd:date ;
    dcterms:creator g02:group02 ;
    dcterms:description "This ontology extends the course affordance vocabulary with group-specific object instances, a gripper-capability extension, and the graspability inference rule for the Group 02 task environment."@en ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:title "AI Capstone 2026 Group 02 Ontology"@en ;
    vann:preferredNamespacePrefix "g02" ;
    vann:preferredNamespaceUri "https://hcis.io/ontology/aicapstone/2026/group02/" ;
    rdfs:comment "Group 02 ontology for semantic affordance grounding. The primary task is cup stacking; the cutlery-arrangement and toy-block-collection baseline objects are also modeled. It imports the shared course vocabulary, supplies the GraspableObject inference rule, and declares the task object instances."@en ;
    owl:imports <https://hcis.io/ontology/aicapstone/2026> .

g02:cupStackingTask a cap:ManipulationTask,
        cap:Task ;
    rdfs:label "cup stacking task"@en ;
    rdfs:comment "Primary task: stack the blue and pink cups; both cups are manipulation targets."@en ;
    cap:hasTargetObject g02:blueCup01,
        g02:pinkCup01 .

g02:cutleryArrangementTask a cap:ManipulationTask,
        cap:Task ;
    rdfs:label "cutlery arrangement task"@en ;
    rdfs:comment "Arrange the knife and fork relative to the plate; the plate is the placement reference."@en ;
    cap:hasReferenceObject g02:plate01 ;
    cap:hasTargetObject g02:fork01,
        g02:knife01 .

g02:robot01 a cap:RobotAgent ;
    rdfs:label "Group 02 robot agent"@en ;
    rdfs:comment "The gripper-equipped robot agent observing the Group 02 task environment."@en .

g02:toyBlockCollectionTask a cap:ManipulationTask,
        cap:Task ;
    rdfs:label "toy block collection task"@en ;
    rdfs:comment "Collect the toy blocks into the basket; the basket is the container target."@en ;
    g02:hasContainerTarget g02:basket01 ;
    cap:hasTargetObject g02:toyBlock01,
        g02:toyBlock02 .

<https://hcis.io/ontology/aicapstone/2026> a owl:Ontology ;
    rdfs:label "AI Capstone 2026 Course Ontology"@en ;
    dcterms:created "2026-05-22"^^xsd:date ;
    dcterms:creator cap:ccyont ;
    dcterms:description "This ontology defines a compact course vocabulary for representing physical task objects, task roles, manipulation affordances, grounding identifiers, and inferable graspability in the AI Capstone 2026 Physical AI project."@en ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:title "AI Capstone 2026 Course Ontology"@en ;
    vann:preferredNamespacePrefix "cap" ;
    vann:preferredNamespaceUri "https://hcis.io/ontology/aicapstone/2026/" ;
    rdfs:comment "A reduced educational ontology profile for semantic and affordance grounding of graspable objects in the AI Capstone 2026 course project."@en .

cap:ccyont a foaf:Person ;
    foaf:mbox <mailto:ccy@hptp.org> ;
    foaf:name "Chun-yien Chang"@en .

g02:basket01 a _:nacdea7238cc94273af924a4b1fa6333fb7,
        cap:Basket,
        cap:PhysicalObject ;
    rdfs:label "basket 01"@en ;
    rdfs:comment "Baseline basket instance, the container target in the toy-block-collection task — not a grasp target."@en ;
    cap:hasAffordance g02:basketContainmentAffordance ;
    cap:hasApproxWidth 0.300 ;
    cap:hasColor "brown" ;
    cap:hasObjectLabel "basket" ;
    cap:hasPoseFrame "world/object_basket" ;
    cap:hasTaskRole cap:ContainerTarget .

g02:basketContainmentAffordance a cap:Affordance,
        cap:ContainmentAffordance ;
    rdfs:label "basket containment affordance"@en ;
    rdfs:comment "Containment affordance of the basket. The basket has NO grasping affordance, so it is not inferred as graspable."@en .

g02:blueCup01 a _:n24e15451f98e4fcfb85943c93941ed80b1,
        _:n24e15451f98e4fcfb85943c93941ed80b2,
        _:nacdea7238cc94273af924a4b1fa6333fb1,
        _:nacdea7238cc94273af924a4b1fa6333fb2,
        _:nacdea7238cc94273af924a4b1fa6333fb3,
        _:nacdea7238cc94273af924a4b1fa6333fb4,
        _:nacdea7238cc94273af924a4b1fa6333fb6,
        cap:Cup,
        cap:GraspableObject,
        cap:PhysicalObject ;
    rdfs:label "blue cup 01"@en ;
    rdfs:comment "The blue cup instance in Group 02's cup-stacking task environment."@en ;
    cap:canBeManipulatedBy g02:gripper01 ;
    cap:hasAffordance g02:blueCupGraspingAffordance,
        g02:blueCupStackingAffordance ;
    cap:hasApproxWidth 0.070 ;
    cap:hasColor "blue" ;
    cap:hasObjectLabel "blue_cup" ;
    cap:hasPoseFrame "world/object_blue_cup" ;
    cap:hasTaskRole cap:TargetObject .

g02:blueCupGraspingAffordance a cap:Affordance,
        cap:GraspingAffordance ;
    rdfs:label "blue cup grasping affordance"@en ;
    rdfs:comment "Grasping affordance of the blue cup; this is what triggers the GraspableObject inference."@en .

g02:blueCupStackingAffordance a cap:Affordance,
        cap:StackabilityAffordance ;
    rdfs:label "blue cup stackability affordance"@en ;
    rdfs:comment "Stackability affordance of the blue cup in the cup-stacking task."@en .

g02:fork01 a _:n24e15451f98e4fcfb85943c93941ed80b1,
        _:n24e15451f98e4fcfb85943c93941ed80b2,
        _:nacdea7238cc94273af924a4b1fa6333fb1,
        _:nacdea7238cc94273af924a4b1fa6333fb3,
        _:nacdea7238cc94273af924a4b1fa6333fb4,
        _:nacdea7238cc94273af924a4b1fa6333fb6,
        cap:Fork,
        cap:GraspableObject,
        cap:PhysicalObject ;
    rdfs:label "fork 01"@en ;
    rdfs:comment "Baseline fork instance for the cutlery-arrangement task."@en ;
    cap:canBeManipulatedBy g02:gripper01 ;
    cap:hasAffordance g02:forkGraspingAffordance ;
    cap:hasApproxWidth 0.025 ;
    cap:hasColor "silver" ;
    cap:hasObjectLabel "fork" ;
    cap:hasPoseFrame "world/object_fork" ;
    cap:hasTaskRole cap:TargetObject .

g02:forkGraspingAffordance a cap:Affordance,
        cap:GraspingAffordance ;
    rdfs:label "fork grasping affordance"@en ;
    rdfs:comment "Grasping affordance of the fork."@en .

g02:group02 a foaf:Group ;
    foaf:member g02:m112550027,
        g02:m112550116,
        g02:m112550117,
        g02:m112550128,
        g02:m112550148,
        g02:m112550166 ;
    foaf:name "AI Capstone 2026 Group 02"@en .

g02:knife01 a _:n24e15451f98e4fcfb85943c93941ed80b1,
        _:n24e15451f98e4fcfb85943c93941ed80b2,
        _:nacdea7238cc94273af924a4b1fa6333fb1,
